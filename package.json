{
  "name": "ai-psychiatrist",
  "version": "2.0.0",
  "description": "Voice-first AI psychiatrist with multi-agent architecture",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "dev:sidecar": "npx tsx server/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev:web": "npx concurrently --names sidecar,client --prefix-colors yellow,cyan \"npm run dev:sidecar\" \"npm run dev:client\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/genai": "^1.40.0",
    "@google/generative-ai": "^0.24.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "nodejs-whisper": "^0.2.9",
    "openai": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
