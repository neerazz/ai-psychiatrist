# LLM -- change this one line to switch models
AI_MODEL=claude-sonnet-4-5
# Options: claude-sonnet-4-5, claude-opus-4-6, gpt-5.2, gemini-3-pro

# API keys (only the one matching AI_MODEL needs to be set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Audio provider
AUDIO_PROVIDER=text
# Options: whisper_tts | gemini_live | text
WHISPER_MODEL=base
# Options: tiny | base | small | medium | large
TTS_PROVIDER=say
# Options: say (macOS built-in) | piper | edge

# External context -- comma-separated files and/or directories
# Agent reads these recursively at session start for background context
EXTERNAL_CONTEXT_PATHS=

# Session storage
DATA_DIR=./data/sessions
