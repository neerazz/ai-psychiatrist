# .env.example - Copy this to .env and fill in your API keys

# AI Model API Keys (at least one required for online mode)
ANTHROPIC_API_KEY=sk-ant-api03-...    # For Claude Sonnet 4.5
GEMINI_API_KEY=AIza...                 # For Gemini 1.5 Pro/Flash

# Speech Services API Keys
DEEPGRAM_API_KEY=...                   # For online STT (Nova-2)
ELEVENLABS_API_KEY=...                 # For online TTS (Dr. Sterling voice)

# ============================================================
# EMBEDDING CONFIGURATION
# ============================================================
# The embedding system supports multiple providers for flexibility:
#   - local (DEFAULT): Uses Transformers.js - no API key needed, runs locally
#   - openai: Uses OpenAI API - requires OPENAI_API_KEY
#   - ollama: Uses local Ollama server - no API key, requires Ollama running
#
# Default: 'local' provider with Xenova/all-MiniLM-L6-v2 (384 dimensions)
# ============================================================

# Embedding provider: 'local' | 'openai' | 'ollama'
EMBEDDING_PROVIDER=local

# Optional: Override default model for the selected provider
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2    # For local
# EMBEDDING_MODEL=text-embedding-3-large     # For openai
# EMBEDDING_MODEL=nomic-embed-text           # For ollama

# Optional: Override default dimensions (must match model output)
# EMBEDDING_DIMENSIONS=384                   # For local
# EMBEDDING_DIMENSIONS=3072                  # For openai
# EMBEDDING_DIMENSIONS=768                   # For ollama

# OpenAI API Key (only required if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Ollama Host (only required if EMBEDDING_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# ============================================================
# SECURITY & ENCRYPTION
# ============================================================
# Master encryption key - 64 hex characters (256 bits)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Keep this secure! Store in environment variable in production.
MASTER_ENCRYPTION_KEY=

# Application Settings
NODE_ENV=development
PORT=3000
